# Copy this file to backend/.env and fill in your real values.
# This file is safe to commit — it contains placeholders only. Never commit backend/.env.

# --- Razorpay (Test Mode) ---
# Get test keys from https://dashboard.razorpay.com/app/keys (use rzp_test_... keys).
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- NVIDIA LLM (reasoning layer) ---
# API key from https://build.nvidia.com/. The app runs fully without it,
# falling back to deterministic intent parsing and recommendations.
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TIMEOUT_SECONDS=12

# --- Bright Data catalog ingestion (backend only) ---
# Configure a Bright Data dataset/API endpoint. The shopping flow reads only
# the locally persisted SQLite catalog, never this service at request time.
BRIGHTDATA_API_KEY=
BRIGHTDATA_API_URL=https://api.brightdata.com/request

# --- Database (optional) ---
# Defaults to a local SQLite file at backend/commerce.db when unset.
# DATABASE_URL=sqlite:///backend/commerce.db
